msgid ""
"Frogman: ensured all API tokens are stored hashed (GHSA-9xf5-9ghq-p6cw)."
msgstr ""
"Frogman: ຮັບປະກັນວ່າທຸກ API token ຖືກຈັດເກັບແບບແຮຊ (GHSA-9xf5-9ghq-p6cw)."

msgid "Frogman: token hash migration failed  "
msgstr "Frogman: ການຍ້າຍຂໍ້ມູນ token hash ລົ້ມເຫຼວ  "

#, php-format
msgid ""
"Frogman: redacted sensitive values from %d historical audit log entries "
"(GHSA-3p65-2prr-cfvf)."
msgstr ""
"Frogman: ປິດບັງຂໍ້ມູນທີ່ລະອຽດອ່ອນຈາກ %d ລາຍການບັນທຶກການກວດສອບຍ້ອນຫຼັງ (GHSA-3p65-2prr-"
"cfvf)."

